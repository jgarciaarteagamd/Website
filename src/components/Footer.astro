---
// Name, address and phone repeated on every page: search engines match them
// against the Google Business Profile, so keep them identical to it.
import { ui, paths } from '../i18n/ui';
import { address, otosur, hospital, infoUrl, bioUrl, LINKEDIN_URL, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---

<footer class="site">
  <div class="wrap grid">
    <div class="nap">
      <p class="who">{t.doctor} · {t.role}</p>
      <p>{otosur.name} · {hospital.name}<br />{address.street}, {address.postalCode} {address.city}</p>
      <p><a href={`tel:${otosur.phone.tel}`}>{otosur.phone.shown}</a> · <a href={`tel:${otosur.mobile.tel}`}>{otosur.mobile.shown}</a></p>
    </div>
    <p class="warn">{t.disclaimer}</p>
    <nav aria-label={lang === 'es' ? 'Enlaces' : 'Links'}>
      <a href={infoUrl(lang)}>{t.patientsLink}</a>
      <a href={bioUrl(lang)}>{t.nav.about}</a>
      <a href={LINKEDIN_URL} rel="me noopener">{t.linkedin}</a>
      <a href={paths.legal(lang)}>{t.legalNotice}</a>
      <a href={paths.privacy(lang)}>{t.privacy}</a>
      <a href={paths.cookies(lang)}>{t.cookies}</a>
    </nav>
    <p class="copy">© {year} {t.brand}</p>
  </div>
</footer>

<style>
  footer.site {
    margin-top: 96px;
    border-top: 1px solid var(--holo-line);
    padding-block: 28px 40px;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .grid { display: grid; gap: 14px; }
  .nap { display: grid; gap: 4px; }
  .nap p { margin: 0; }
  .nap .who { font-family: var(--display); color: var(--ink); font-size: 1rem; }
  .warn { margin: 0; max-width: 70ch; color: var(--ink); }
  nav { display: flex; flex-wrap: wrap; gap: 6px 22px; }
  nav a {
    font-family: var(--label);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .copy { margin: 0; font-family: var(--label); font-size: 0.72rem; letter-spacing: 0.08em; }
  /* room for the call bar on phones (LandingPage.astro) */
  @media (max-width: 640px) {
    footer.site { padding-bottom: 96px; }
  }
</style>
