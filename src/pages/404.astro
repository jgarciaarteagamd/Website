---
import Base from '../layouts/Base.astro';
import { infoUrl } from '../data/site';
---
<Base lang="es" title="404 · Juan García Arteaga, ORL" description="Página no encontrada / Page not found" alt="/en/">
  <section class="wrap nf">
    <p class="label">404</p>
    <h1>Página no encontrada</h1>
    <p>La dirección no existe o ha cambiado. <a href="/">Ir al inicio</a> · <a href={infoUrl('es')}>Información para pacientes</a></p>
    <p lang="en">Page not found. This address does not exist or has changed. <a href="/en/">Go to the home page</a> · <a href={infoUrl('en')}>Patient information</a></p>
  </section>
</Base>
<style>
  .nf { padding-block: 96px; display: grid; gap: 14px; }
  .nf p { margin: 0; }
</style>
